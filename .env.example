# Copy to .env.local if needed. This file is parsed as simple KEY=VALUE data, not executed.
# Optional LAN access through your private network / WireGuard.
# LIFE_LISTEN_HOST=0.0.0.0
# LIFE_ALLOWED_HOSTS=192.168.1.145
# Optional trusted local HTTP proxy for RSS collection (e.g. macOS proxy software).
# LIFE_FEED_PROXY=http://127.0.0.1:7897

# Model configuration may instead be entered in the app Settings page.
# LIFE_MODEL_BASE_URL=https://your-provider.example/v1
# LIFE_MODEL_NAME=your-model-name
# LIFE_MODEL_API_KEY=your-secret

# Existing local TTS defaults to this address; its password is read locally.
# LIFE_TTS_BASE_URL=http://127.0.0.1:7866

# Optional Zhihu developer Access Secret (can instead be saved in app settings).
# LIFE_ZHIHU_ACCESS_SECRET=your-secret
# LIFE_ZHIHU_PROXY=http://127.0.0.1:7897
